// ==============================================================================
// TAGAD SYSTEM — CANONICAL PRISMA SCHEMA (BLUEPRINT V2)
// Target: PostgreSQL / Supabase
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ENCODER
  VIEWER

  @@map("canonical_role")
}

enum Sex {
  MALE
  FEMALE

  @@map("beneficiary_sex")
}

enum GADPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISED

  @@map("canonical_plan_status")
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("canonical_program_status")
}

// ------------------------------------------------------------------------------
// ORGANIZATIONAL ENTITIES
// ------------------------------------------------------------------------------

model Office {
  provisionalSeries ProvisionalGadSeries[]
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(255)
  headName    String?       @map("head_name") @db.VarChar(255)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  users         User[]
  beneficiaries Beneficiary[]
  programs      Program[]
  gadPlans      GADPlan[]

  @@map("tagad_offices")
}

model Barangay {
  provisionalReference ProvisionalGadReference?
  provisionalEntries ProvisionalGadEntry[]
  id             String        @id @default(uuid()) @db.Uuid
  name           String        @unique @db.VarChar(100)
  code           String        @unique @db.VarChar(50)
  captainName    String?       @map("captain_name") @db.VarChar(255)
  gadFocalPerson String?       @map("gad_focal_person") @db.VarChar(255)
  contactNumber  String?       @map("contact_number") @db.VarChar(50)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // WGS84 coordinates; null means no verified source has supplied a location.
  latitude       Float?        @db.DoublePrecision
  longitude      Float?        @db.DoublePrecision
  boundary       Json?
  geoSource      String?       @map("geo_source")
  geoVerified    Boolean       @default(false) @map("geo_verified")

  households    Household[]
  beneficiaries Beneficiary[]
  users         User[]
  statisticalObservations StatisticalObservation[]

  @@map("tagad_barangays")
}

model Household {
  id          String        @id @default(uuid()) @db.Uuid
  householdNo String        @unique @map("household_no") @db.VarChar(100)
  barangayId  String        @map("barangay_id") @db.Uuid
  purok       String?       @db.VarChar(100)
  is4Ps       Boolean       @default(false) @map("is_4ps")
  isIndigent  Boolean       @default(false) @map("is_indigent")
  headName    String?       @map("head_name") @db.VarChar(255)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  barangay      Barangay      @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  beneficiaries Beneficiary[]

  @@map("tagad_households")
}

// ------------------------------------------------------------------------------
// IDENTITY & USERS
// ------------------------------------------------------------------------------

model User {
  provisionalSeries ProvisionalGadSeries[]
  provisionalEntries ProvisionalGadEntry[]
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(255)
  role         Role          @default(ENCODER)
  officeId     String?       @map("office_id") @db.Uuid
  barangayId   String?       @map("barangay_id") @db.Uuid
  isActive     Boolean       @default(true) @map("is_active")
  avatarUrl    String?       @map("avatar_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  office              Office?             @relation(fields: [officeId], references: [id], onDelete: SetNull)
  barangay            Barangay?           @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  encodedBeneficiaries Beneficiary[]      @relation("EncodedByUser")
  createdPrograms     Program[]           @relation("ProgramCreatedBy")
  createdGADPlans     GADPlan[]           @relation("GADPlanCreatedBy")
  createdAccomplishments GADAccomplishment[] @relation("AccomplishmentCreatedBy")
  uploadedMOVs        MOVAttachment[]     @relation("MOVUploadedBy")
  auditLogs           AuditLog[]
  importedDatasets    StatisticalDataset[] @relation("DatasetImportedBy")
  provenanceRecords   StatisticalProvenance[] @relation("ProvenanceImportedBy")
  revokedTokens       RevokedToken[]
  reviewedFeedback    CitizenFeedback[]

  @@map("tagad_users")
}

// ------------------------------------------------------------------------------
// BENEFICIARY REGISTRY
// ------------------------------------------------------------------------------

model Beneficiary {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String?       @map("household_id") @db.Uuid
  officeId      String?       @map("office_id") @db.Uuid
  barangayId    String        @map("barangay_id") @db.Uuid
  firstName     String        @map("first_name") @db.VarChar(100)
  lastName      String        @map("last_name") @db.VarChar(100)
  middleName    String?       @map("middle_name") @db.VarChar(100)
  sex           Sex
  birthdate     DateTime?     @db.Date
  age           Int
  sector        String        @db.VarChar(100)
  contactNumber String?       @map("contact_number") @db.VarChar(50)
  addressStreet String?       @map("address_street")
  isArchived    Boolean       @default(false) @map("is_archived")
  encodedById   String?       @map("encoded_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  office    Office?    @relation(fields: [officeId], references: [id], onDelete: SetNull)
  barangay  Barangay   @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  encodedBy User?      @relation("EncodedByUser", fields: [encodedById], references: [id], onDelete: SetNull)

  @@index([barangayId])
  @@index([sex])
  @@index([sector])
  @@map("tagad_beneficiaries")
}

// ------------------------------------------------------------------------------
// GAD PLANNING & OPERATIONAL PROGRAMS
// ------------------------------------------------------------------------------

model GADPlan {
  id                      String         @id @default(uuid()) @db.Uuid
  officeId                String         @map("office_id") @db.Uuid
  fiscalYear              Int            @map("fiscal_year")
  totalBudget             Decimal        @default(0.00) @map("total_budget") @db.Decimal(14, 2)
  mandatoryGADPercentage  Decimal        @default(5.00) @map("mandatory_gad_percentage") @db.Decimal(5, 2)
  gadBudget               Decimal        @default(0.00) @map("gad_budget") @db.Decimal(14, 2)
  status                  GADPlanStatus  @default(DRAFT)
  createdById             String?        @map("created_by") @db.Uuid
  updatedById             String?        @map("updated_by") @db.Uuid
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  office     Office        @relation(fields: [officeId], references: [id], onDelete: Restrict)
  createdBy  User?         @relation("GADPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items      GADPlanItem[]

  @@unique([officeId, fiscalYear])
  @@map("tagad_gad_plans")
}

model GADPlanItem {
  id                    String      @id @default(uuid()) @db.Uuid
  gadPlanId             String      @map("gad_plan_id") @db.Uuid
  programId             String?     @map("program_id") @db.Uuid
  genderIssue           String      @map("gender_issue")
  causeOfIssue          String?     @map("cause_of_issue")
  gadResult             String      @map("gad_result")
  activity              String
  performanceIndicator  String      @map("performance_indicator")
  targetGroup           String      @map("target_group") @db.VarChar(255)
  timeline              String      @db.VarChar(100)
  responsibleOffice     String      @map("responsible_office") @db.VarChar(255)
  budget                Decimal     @default(0.00) @db.Decimal(14, 2)
  fundSource            String      @default("General Fund (5% GAD)") @map("fund_source") @db.VarChar(100)
  hgdgScore             Decimal?    @map("hgdg_score") @db.Decimal(5, 2)
  attributedPercentage  Decimal?    @map("attributed_percentage") @db.Decimal(5, 2)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  gadPlan          GADPlan             @relation(fields: [gadPlanId], references: [id], onDelete: Cascade)
  program          Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  accomplishments  GADAccomplishment[]

  @@index([gadPlanId])
  @@map("tagad_gad_plan_items")
}

model Program {
  id            String         @id @default(uuid()) @db.Uuid
  officeId      String         @map("office_id") @db.Uuid
  title         String         @db.VarChar(255)
  description   String?
  sector        String         @db.VarChar(100)
  fiscalYear    Int            @map("fiscal_year")
  status        ProgramStatus  @default(ACTIVE)
  budgetTarget  Decimal        @default(0.00) @map("budget_target") @db.Decimal(14, 2)
  budgetActual  Decimal        @default(0.00) @map("budget_actual") @db.Decimal(14, 2)
  targetMale    Int            @default(0) @map("target_male")
  targetFemale  Int            @default(0) @map("target_female")
  actualMale    Int            @default(0) @map("actual_male")
  actualFemale  Int            @default(0) @map("actual_female")
  createdById   String?        @map("created_by") @db.Uuid
  updatedById   String?        @map("updated_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  office          Office              @relation(fields: [officeId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("ProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  gadPlanItems    GADPlanItem[]
  accomplishments GADAccomplishment[]

  @@index([fiscalYear, officeId])
  @@map("tagad_programs")
}

// ------------------------------------------------------------------------------
// IMPLEMENTATION RESULTS & EVIDENCE
// ------------------------------------------------------------------------------

model GADAccomplishment {
  id                   String        @id @default(uuid()) @db.Uuid
  programId            String?       @map("program_id") @db.Uuid
  gadPlanItemId        String?       @map("gad_plan_item_id") @db.Uuid
  fiscalYear           Int           @map("fiscal_year")
  quarter              Int?
  actualOutput         String        @map("actual_output")
  actualMale           Int           @default(0) @map("actual_beneficiary_male")
  actualFemale         Int           @default(0) @map("actual_beneficiary_female")
  actualBudgetUsed     Decimal       @default(0.00) @map("actual_budget_used") @db.Decimal(14, 2)
  outputSummary        String?       @map("output_summary")
  remarks              String?
  varianceExplanation  String?       @map("variance_explanation")
  createdById          String?       @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  program      Program?        @relation(fields: [programId], references: [id], onDelete: Cascade)
  gadPlanItem  GADPlanItem?    @relation(fields: [gadPlanItemId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("AccomplishmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attachments  MOVAttachment[]

  @@index([programId])
  @@map("tagad_accomplishments")
}

model MOVAttachment {
  id                String            @id @default(uuid()) @db.Uuid
  accomplishmentId  String            @map("accomplishment_id") @db.Uuid
  storagePath       String            @map("storage_path")
  fileName          String            @map("file_name") @db.VarChar(255)
  fileType          String            @map("file_type") @db.VarChar(100)
  fileSizeBytes     Int               @map("file_size_bytes")
  uploadedById      String?           @map("uploaded_by") @db.Uuid
  uploadedAt        DateTime          @default(now()) @map("uploaded_at")

  accomplishment GADAccomplishment @relation(fields: [accomplishmentId], references: [id], onDelete: Cascade)
  uploadedBy     User?             @relation("MOVUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([accomplishmentId])
  @@map("tagad_mov_attachments")
}

// ------------------------------------------------------------------------------
// AUDIT LOGS
// ------------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, action])
  @@index([createdAt(sort: Desc)])
  @@map("tagad_audit_logs")
}

// ------------------------------------------------------------------------------
// STATISTICAL DOMAIN & 69-TABLE METADATA CATALOG (SPRINT 7 FOUNDATION)
// ------------------------------------------------------------------------------

enum StatisticalTableClassification {
  AGGREGATED_STATISTICS
  INDICATOR
  DERIVED_METRIC
  REFERENCE_DATA
  UNVERIFIED

  @@map("canonical_stat_classification")
}

enum StatisticalPublicationStatus {
  DRAFT
  VALIDATED
  OFFICIAL
  PUBLISHED
  WITHDRAWN

  @@map("canonical_stat_pub_status")
}

enum StatisticalVerificationStatus {
  UNVERIFIED
  PROVISIONAL
  VERIFIED

  @@map("canonical_stat_verif_status")
}

model StatisticalTableDefinition {
  id                 String                         @id @default(uuid()) @db.Uuid
  tableNumber        Int                            @unique @map("table_number")
  tableCode          String                         @unique @map("table_code") @db.VarChar(50)
  title              String                         @db.VarChar(500)
  domain             String                         @db.VarChar(100)
  classification     StatisticalTableClassification @default(UNVERIFIED)
  description        String?                        @db.Text
  expectedUnit       String?                        @map("expected_unit") @db.VarChar(100)
  rowGrain           String?                        @default("UNVERIFIED") @map("row_grain") @db.VarChar(255)
  dimensionsSummary  String?                        @default("UNVERIFIED") @map("dimensions_summary") @db.VarChar(255)
  measureStructure   String?                        @default("UNVERIFIED") @map("measure_structure") @db.VarChar(255)
  sourceFormat       String?                        @default("UNVERIFIED") @map("source_format") @db.VarChar(100)
  isSystemTable      Boolean                        @default(false) @map("is_system_table")
  isArchived         Boolean                        @default(false) @map("is_archived")
  verificationStatus StatisticalVerificationStatus  @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  indicators        StatisticalIndicator[]
  observations      StatisticalObservation[]
  dimensionBindings TableDimensionBinding[]

  @@index([domain])
  @@index([classification])
  @@map("tagad_statistical_table_definitions")
}

model StatisticalDataset {
  id                 String                        @id @default(uuid()) @db.Uuid
  datasetCode        String                        @unique @map("dataset_code") @db.VarChar(100)
  name               String                        @db.VarChar(255)
  description        String?                       @db.Text
  sourceAgency       String?                       @map("source_agency") @db.VarChar(100)
  reportingYear      Int?                          @map("reporting_year")
  reportingPeriod    String?                       @map("reporting_period") @db.VarChar(100)
  surveyRound        String?                       @map("survey_round") @db.VarChar(100)
  geographicLevel    String?                       @default("MUNICIPALITY") @map("geographic_level") @db.VarChar(50)
  sourceFileName     String?                       @map("source_file_name") @db.VarChar(255)
  ingestionBatchId   String?                       @map("ingestion_batch_id") @db.Uuid
  importedById       String?                       @map("imported_by_id") @db.Uuid
  isOfficial         Boolean                       @default(false) @map("is_official")
  isPublished        Boolean                       @default(false) @map("is_published")
  publicationStatus  StatisticalPublicationStatus  @default(DRAFT) @map("publication_status")
  verificationStatus StatisticalVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  importedBy   User?                    @relation("DatasetImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  observations StatisticalObservation[]

  @@index([reportingYear, sourceAgency])
  @@index([publicationStatus])
  @@map("tagad_statistical_datasets")
}

model StatisticalIndicator {
  id                    String                         @id @default(uuid()) @db.Uuid
  indicatorCode         String                         @unique @map("indicator_code") @db.VarChar(100)
  name                  String                         @db.VarChar(255)
  title                 String                         @db.VarChar(500)
  description           String?                        @db.Text
  unit                  String?                        @db.VarChar(100)
  classification        StatisticalTableClassification @default(INDICATOR)
  formula               String?                        @db.Text
  numeratorDefinition   String?                        @map("numerator_definition") @db.Text
  denominatorDefinition String?                        @map("denominator_definition") @db.Text
  tableDefinitionId     String?                        @map("table_definition_id") @db.Uuid
  verificationStatus    StatisticalVerificationStatus  @default(UNVERIFIED) @map("verification_status")
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  tableDefinition StatisticalTableDefinition? @relation(fields: [tableDefinitionId], references: [id], onDelete: SetNull)
  observations    StatisticalObservation[]

  @@index([tableDefinitionId])
  @@map("tagad_statistical_indicators")
}

model StatisticalDimension {
  id                 String                        @id @default(uuid()) @db.Uuid
  dimensionCode      String                        @unique @map("dimension_code") @db.VarChar(100)
  name               String                        @db.VarChar(255)
  description        String?                       @db.Text
  dataType           String                        @default("string") @map("data_type") @db.VarChar(50)
  vocabularySource   String?                       @map("vocabulary_source") @db.VarChar(255)
  verificationStatus StatisticalVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  tableBindings      TableDimensionBinding[]

  @@map("tagad_statistical_dimensions")
}

model TableDimensionBinding {
  id                String                     @id @default(uuid()) @db.Uuid
  tableDefinitionId String                     @map("table_definition_id") @db.Uuid
  dimensionId       String                     @map("dimension_id") @db.Uuid
  displayOrder      Int                        @default(0) @map("display_order")
  isRequired        Boolean                    @default(true) @map("is_required")
  allowedValues     Json?                      @map("allowed_values")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  tableDefinition   StatisticalTableDefinition @relation(fields: [tableDefinitionId], references: [id], onDelete: Cascade)
  dimension         StatisticalDimension       @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@unique([tableDefinitionId, dimensionId])
  @@index([tableDefinitionId, displayOrder])
  @@map("tagad_table_dimension_bindings")
}

model StatisticalProvenance {
  id               String   @id @default(uuid()) @db.Uuid
  sourceAgency     String?  @map("source_agency") @db.VarChar(100)
  sourceFileName   String?  @map("source_file_name") @db.VarChar(255)
  sourceDocument   String?  @map("source_document") @db.VarChar(255)
  datasetCode      String?  @map("dataset_code") @db.VarChar(100)
  tableCode        String?  @map("table_code") @db.VarChar(50)
  reportingPeriod  String?  @map("reporting_period") @db.VarChar(100)
  importedById     String?  @map("imported_by_id") @db.Uuid
  ingestionBatchId String?  @map("ingestion_batch_id") @db.Uuid
  methodologyNotes String?  @map("methodology_notes") @db.Text
  sourceUrl        String?  @map("source_url") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  importedBy   User?                    @relation("ProvenanceImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  observations StatisticalObservation[]

  @@map("tagad_statistical_provenance")
}

model StatisticalObservation {
  id                 String                  @id @default(uuid()) @db.Uuid
  datasetId          String                  @map("dataset_id") @db.Uuid
  tableDefinitionId  String                  @map("table_definition_id") @db.Uuid
  indicatorId        String?                 @map("indicator_id") @db.Uuid
  barangayId         String?                 @map("barangay_id") @db.Uuid
  period             String                  @db.VarChar(50)
  numericValue       Decimal                 @map("numeric_value") @db.Decimal(18, 4)
  unit               String?                 @db.VarChar(100)
  dimensions         Json?
  dimensionsHash     String?                 @map("dimensions_hash") @db.VarChar(64)
  provenanceId       String?                 @map("provenance_id") @db.Uuid
  suppressionStatus  String?                 @default("NONE") @map("suppression_status") @db.VarChar(50)
  suppressionReason  String?                 @map("suppression_reason") @db.VarChar(255)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  dataset         StatisticalDataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  tableDefinition StatisticalTableDefinition @relation(fields: [tableDefinitionId], references: [id], onDelete: Restrict)
  indicator       StatisticalIndicator?      @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  barangay        Barangay?                  @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  provenance      StatisticalProvenance?     @relation(fields: [provenanceId], references: [id], onDelete: SetNull)

  @@index([datasetId, tableDefinitionId])
  @@index([barangayId, period])
  @@index([indicatorId])
  @@map("tagad_statistical_observations")
}

// ------------------------------------------------------------------------------
// DURABLE SECURITY & AUTHENTICATION (SPRINT 9)
// ------------------------------------------------------------------------------

model RevokedToken {
  id         String    @id @default(uuid()) @db.Uuid
  jti        String?   @unique @db.VarChar(255)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userId     String?   @map("user_id") @db.Uuid
  reason     String?   @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime  @default(now()) @map("revoked_at")

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([jti])
  @@index([expiresAt])
  @@index([userId])
  @@map("tagad_revoked_tokens")
}

model CitizenFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @db.VarChar(255)
  subject      String   @db.VarChar(255)
  message      String   @db.Text
  status       String   @default("NEW") @db.VarChar(20)
  reviewNote   String?  @map("review_note") @db.VarChar(2000)
  reviewedById String?  @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  reviewedBy   User? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("tagad_citizen_feedback")
}


// Isolated internal aggregates. No relation to statistical publication datasets.
model ProvisionalGadSeries {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(80)
  name String @db.VarChar(200)
  sourceReference String @map("source_reference") @db.VarChar(1000)
  owningOfficeId String @map("owning_office_id") @db.Uuid
  creatorId String @map("creator_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  office Office @relation(fields: [owningOfficeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator User @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  entries ProvisionalGadEntry[]
  @@unique([id, owningOfficeId])
  @@map("tagad_provisional_gad_series")
}

// Evidence must be provisioned by a custodian; no UI/API can approve a roster.
// Synthetic references are accepted only with NODE_ENV=test.
model ProvisionalGadReference {
  barangayId String @id @map("barangay_id") @db.Uuid
  evidence String @db.VarChar(1000)
  isSynthetic Boolean @default(false) @map("is_synthetic")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@map("tagad_provisional_gad_references")
}

model ProvisionalGadEntry {
  id String @id @default(uuid()) @db.Uuid
  seriesId String @map("series_id") @db.Uuid
  barangayId String @map("barangay_id") @db.Uuid
  period String @db.VarChar(50)
  male Int
  female Int
  owningOfficeId String @map("owning_office_id") @db.Uuid
  creatorId String @map("creator_id") @db.Uuid
  sourceReference String @map("source_reference") @db.VarChar(1000)
  sourceFileName String? @map("source_file_name") @db.VarChar(255)
  batchId String @map("batch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  series ProvisionalGadSeries @relation(fields: [seriesId, owningOfficeId], references: [id, owningOfficeId], onDelete: Restrict, onUpdate: NoAction)
  barangay Barangay @relation(fields: [barangayId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator User @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([seriesId, barangayId, period])
  @@index([owningOfficeId, seriesId, period], map: "tagad_provisional_gad_entries_scope")
  @@map("tagad_provisional_gad_entries")
}
