# Backend Environment Variables (SECRETS - DO NOT EXPOSE TO FRONTEND)

# Node Environment
NODE_ENV=development

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# JWT Authentication (BACKEND ONLY - NEVER EXPOSE)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Demo fallback authentication (must be explicitly enabled; never use in production)
DEMO_MODE=false
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_ENCODER_PASSWORD=
DEMO_VIEWER_PASSWORD=

# Database-seeded account passwords (required by prisma seed)
ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD=

# Google Generative AI (BACKEND ONLY - NEVER EXPOSE)
GEMINI_API_KEY=

# Server Configuration
PORT=3000
# Default: direct connections, no forwarded-header trust. See docs/proxy-topology.md.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FEEDBACK_MAX=5

# Optional: Supabase Configuration (Backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MOV_BUCKET=mov-attachments

# Optional backend-only error tracking. No request bodies/user details are sent.
SENTRY_DSN=
SENTRY_RELEASE=
