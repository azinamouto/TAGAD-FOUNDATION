# Reference for Render's environment dashboard. Never commit filled credentials.
# dotenv loads .env by default, NOT this file or .env.production automatically.
NODE_ENV=production
DEMO_MODE=false
# Render supplies PORT; omit this override in Render unless needed.
PORT=3000

# Copy connection strings from Supabase Connect. Use TLS (sslmode=require).
# Session pooler (5432) works for this long-running API on IPv4-only networks.
# DIRECT_URL is a direct/session connection, never the transaction pooler.
# URL-encode special characters in the database password.
DATABASE_URL=
DIRECT_URL=

# Two distinct randomly generated values, at least 32 random bytes each.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Exact HTTPS frontend origins, comma-separated, without paths or trailing slash.
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
# Initial conservative setting; verify ingress before enabling trust. Never true.
TRUST_PROXY=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FEEDBACK_MAX=5

# Backend only. Required for private MOV file uploads/downloads.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MOV_BUCKET=mov-attachments

# Backend error tracking; use the deployed commit SHA as the release.
SENTRY_DSN=
SENTRY_RELEASE=

# Optional, only if the AI feature is used.
GEMINI_API_KEY=

# Seed-only credentials: supply to the one-time seed process, not the web service.
# ADMIN_PASSWORD=
# SUPER_ADMIN_PASSWORD=
