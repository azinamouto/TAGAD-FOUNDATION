# All browser API calls (auth, application data and exports) share this root.
# Same-origin hosting: /api (also proxied to localhost:3000 by the Vite dev server).
VITE_API_BASE_URL=/api

# Split hosting: set an absolute backend URL, including the API path.
# VITE_API_BASE_URL=https://api.example.com/api
# Allow the frontend origin in backend CORS_ORIGINS. Rebuild after changes.
