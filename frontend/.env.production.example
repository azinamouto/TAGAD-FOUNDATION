# Public build-time values only. Configure in Vercel's Production environment.
# For a local production build, copy to .env.production.local (gitignored).
# Include /api; a blank value sends requests to Vercel instead of the backend.
VITE_API_BASE_URL=https://YOUR-API.onrender.com/api

# Optional legacy browser Supabase integration. Leave blank for Express JWT auth.
# Never use the service-role key or database credentials here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
